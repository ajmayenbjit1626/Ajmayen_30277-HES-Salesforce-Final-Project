    <sharingCriteriaRules>
        <fullName>Benelux_open_cases_to_Benelux_service</fullName>
        <accessLevel>Edit</accessLevel>
        <description>ACC-02-R1: open Benelux cases visible to the Benelux service group, also after assignment to an engineer.</description>
        <label>Benelux open cases to Benelux service</label>
        <sharedTo>
            <group>HES_Benelux_Service</group>
        </sharedTo>
        <criteriaItems>
            <field>Region__c</field>
            <operation>equals</operation>
            <value>Benelux</value>
        </criteriaItems>
        <criteriaItems>
            <field>Status</field>
            <operation>notEqual</operation>
            <value>Closed</value>
        </criteriaItems>
        <includeRecordsOwnedByAll>true</includeRecordsOwnedByAll>
    </sharingCriteriaRules>
