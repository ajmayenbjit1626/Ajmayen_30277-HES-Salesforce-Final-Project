<?xml version="1.0" encoding="UTF-8"?>
<PathAssistant xmlns="http://soap.sforce.com/2006/04/metadata">
    <active>true</active>
    <entityName>Opportunity</entityName>
    <fieldName>StageName</fieldName>
    <masterLabel>HES Opportunity Path</masterLabel>
    <pathAssistantSteps>
        <fieldNames>Description</fieldNames>
        <fieldNames>NextStep</fieldNames>
        <info>&lt;p&gt;Record why the deal was lost in Description (price, competitor, timing) so the team can learn from it.&lt;/p&gt;</info>
        <picklistValueName>Closed Lost</picklistValueName>
    </pathAssistantSteps>
    <pathAssistantSteps>
        <fieldNames>Amount</fieldNames>
        <fieldNames>Description</fieldNames>
        <info>&lt;p&gt;Well done! Equipment records and a draft coverage plan are created automatically. Hand over to the service team.&lt;/p&gt;</info>
        <picklistValueName>Closed Won</picklistValueName>
    </pathAssistantSteps>
    <pathAssistantSteps>
        <fieldNames>Equipment_Type__c</fieldNames>
        <fieldNames>NextStep</fieldNames>
        <fieldNames>CloseDate</fieldNames>
        <fieldNames>Amount</fieldNames>
        <info>&lt;p&gt;Agree the required capacity (kW or m3/h), site limits (space, power, noise) and who makes the decision. Plan a site visit if needed and record it in Next Step.&lt;/p&gt;</info>
        <picklistValueName>Needs Analysis</picklistValueName>
    </pathAssistantSteps>
    <pathAssistantSteps>
        <fieldNames>Amount</fieldNames>
        <fieldNames>Discount__c</fieldNames>
        <fieldNames>CloseDate</fieldNames>
        <fieldNames>NextStep</fieldNames>
        <info>&lt;p&gt;The opportunity must have at least one equipment line to enter this stage. Submit discounts above 15% for approval; the record locks until the manager decides.&lt;/p&gt;</info>
        <picklistValueName>Negotiation/Review</picklistValueName>
    </pathAssistantSteps>
    <pathAssistantSteps>
        <fieldNames>Amount</fieldNames>
        <fieldNames>Discount__c</fieldNames>
        <fieldNames>CloseDate</fieldNames>
        <fieldNames>NextStep</fieldNames>
        <info>&lt;p&gt;Add the equipment lines (Products) before sending the proposal; Amount is calculated from them. Any discount above 15% needs your manager&amp;#39;s approval.&lt;/p&gt;</info>
        <picklistValueName>Proposal/Price Quote</picklistValueName>
    </pathAssistantSteps>
    <pathAssistantSteps>
        <fieldNames>ExpectedRevenue</fieldNames>
        <fieldNames>Site_Postcode__c</fieldNames>
        <fieldNames>Indicative_Budget__c</fieldNames>
        <fieldNames>LeadSource</fieldNames>
        <info>&lt;p&gt;Confirm the customer&amp;#39;s need, the installation site and a realistic budget. Check the account&amp;#39;s Region is set so the right regional team follows up.&lt;/p&gt;</info>
        <picklistValueName>Qualification</picklistValueName>
    </pathAssistantSteps>
    <recordTypeName>__MASTER__</recordTypeName>
</PathAssistant>
