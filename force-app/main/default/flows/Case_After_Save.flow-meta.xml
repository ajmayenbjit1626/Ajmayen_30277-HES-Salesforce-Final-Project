    <recordUpdates>
        <description>Sets the serviced unit&apos;s Last Service Date to today (SVC-05).</description>
        <name>Stamp_Last_Service_Date</name>
        <label>Stamp Last Service Date</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Send_Satisfaction_Email</targetReference>
        </connector>
        <faultConnector>
            <targetReference>Log_Closure_Failure</targetReference>
        </faultConnector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Equipment__c</elementReference>
            </value>
        </filters>
        <inputAssignments>
            <field>Last_Service_Date__c</field>
            <value>
                <elementReference>$Flow.CurrentDate</elementReference>
            </value>
        </inputAssignments>
        <object>Equipment__c</object>
    </recordUpdates>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>What_Happened</targetReference>
        </connector>
        <filterFormula>OR( ISNEW(), ISCHANGED({!$Record.Status}) )</filterFormula>
        <object>Case</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Active</status>
</Flow>
