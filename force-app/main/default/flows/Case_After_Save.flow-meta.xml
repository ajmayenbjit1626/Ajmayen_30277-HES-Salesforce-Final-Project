    <decisions>
        <description>Only cases linked to a unit can update its service date.</description>
        <name>Has_Equipment</name>
        <label>Has Equipment?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>Send_Satisfaction_Email</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>No</defaultConnectorLabel>
        <rules>
            <name>Has_Equipment_Yes</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Equipment__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Stamp_Last_Service_Date</targetReference>
            </connector>
            <label>Yes</label>
        </rules>
    </decisions>
    <decisions>
        <description>Routes the case to the right automation: new genuine case (acknowledgement); later closure and reopen (6-06, 6-07).</description>
        <name>What_Happened</name>
        <label>What Happened?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>END_ELEMENT_1</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Other Change</defaultConnectorLabel>
        <rules>
            <name>New_Genuine_Case</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>fxIsNew</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Reason</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <stringValue>Junk</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Which_Channel</targetReference>
            </connector>
            <label>New Genuine Case</label>
        </rules>
        <rules>
            <name>Just_Closed</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>fxJustClosed</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Has_Equipment</targetReference>
            </connector>
            <label>Just Closed</label>
        </rules>
    </decisions>
    <decisions>
        <description>Chooses the acknowledgement that matches how the case arrived (INT-04).</description>
        <name>Which_Channel</name>
        <label>Which Channel?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>END_ELEMENT_1</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Other Channel</defaultConnectorLabel>
        <rules>
            <name>Email</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Origin</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Email</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.SuppliedEmail</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Send_Email_Acknowledgement</targetReference>
            </connector>
            <label>Email</label>
        </rules>
        <rules>
            <name>Web</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Origin</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Web</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.SuppliedEmail</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Send_Web_Acknowledgement</targetReference>
            </connector>
            <label>Web</label>
        </rules>
    </decisions>
    <description>After-save automation for Case. On create: channel-specific acknowledgement email (INT-04), skipped for junk. Later outcomes on status change: closure (6-06) and reopen (6-07). Runs only on create or status change. Just Closed: stamps Last Service Date on the unit and sends the satisfaction email (SVC-05). Future work segments are removed by the scheduling service via the Case trigger (7-06), not here.</description>
    <ends>
        <name>END_ELEMENT_1</name>
        <locationX>0</locationX>
        <locationY>0</locationY>
    </ends>
    <ends>
        <name>END_ELEMENT_2</name>
        <locationX>0</locationX>
        <locationY>0</locationY>
    </ends>
    <ends>
        <name>END_ELEMENT_3</name>
        <locationX>0</locationX>
        <locationY>0</locationY>
    </ends>
    <environments>Default</environments>
    <formulas>
        <description>True when the case was just created (not an update).</description>
        <name>fxIsNew</name>
        <dataType>Boolean</dataType>
        <expression>ISNEW()</expression>
    </formulas>
    <formulas>
        <description>True only at the moment a non-junk case becomes closed.</description>
        <name>fxJustClosed</name>
        <dataType>Boolean</dataType>
        <expression>AND(
  ISCHANGED({!$Record.IsClosed}),
  {!$Record.IsClosed},
  TEXT({!$Record.Reason}) &lt;&gt; &quot;Junk&quot;
)</expression>
    </formulas>
    <interviewLabel>Case After Save {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Case After Save</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordCreates>
        <description>If the acknowledgement email fails, creates a follow-up task on the case instead of losing the case.</description>
        <name>Create_Ack_Failure_Task</name>
        <label>Create Ack Failure Task</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
