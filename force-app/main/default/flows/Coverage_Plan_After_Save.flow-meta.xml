<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>68.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <assignments>
        <description>Points the unit at this plan and adds it to the update list.</description>
        <name>Prepare_Unit</name>
        <label>Prepare Unit</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>varUnit.Id</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>Loop_Links.Equipment__c</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>varUnit.Current_Coverage_Plan__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>colUnits</assignToReference>
            <operator>Add</operator>
            <value>
                <elementReference>varUnit</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Loop_Links</targetReference>
        </connector>
    </assignments>
    <customErrors>
        <description>Stops the activation and shows a friendly message instead of a raw exception.</description>
        <name>Show_Activation_Error</name>
        <label>Show Activation Error</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>END_ELEMENT_2</targetReference>
        </connector>
        <customErrorMessages>
            <errorMessage>{!$Label.Coverage_activation_failed}</errorMessage>
            <isFieldError>false</isFieldError>
        </customErrorMessages>
    </customErrors>
    <description>After-save automation for Coverage Plan. When a plan becomes Active, sets Current Coverage Plan on every covered equipment unit so the Coverage Position formula can read it (SVC-03). Bulk-safe: one query, one update.</description>
    <ends>
        <name>END_ELEMENT_1</name>
        <locationX>0</locationX>
        <locationY>0</locationY>
    </ends>
    <ends>
        <name>END_ELEMENT_2</name>
        <locationX>0</locationX>
        <locationY>0</locationY>
    </ends>
    <environments>Default</environments>
    <interviewLabel>Coverage Plan After Save {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Coverage Plan After Save</label>
    <loops>
        <description>Goes through each link of the plan.</description>
        <name>Loop_Links</name>
        <label>Loop Links</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <collectionReference>Get_Links</collectionReference>
        <iterationOrder>Asc</iterationOrder>
        <nextValueConnector>
            <targetReference>Prepare_Unit</targetReference>
        </nextValueConnector>
        <noMoreValuesConnector>
            <targetReference>Update_Units</targetReference>
        </noMoreValuesConnector>
    </loops>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordLookups>
        <description>Reads every Equipment Coverage link of the activated plan, to find the units it covers.</description>
        <name>Get_Links</name>
        <label>Get Links</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Loop_Links</targetReference>
        </connector>
        <faultConnector>
            <isGoTo>true</isGoTo>
            <targetReference>Show_Activation_Error</targetReference>
        </faultConnector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Coverage_Plan__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>false</getFirstRecordOnly>
        <object>Equipment_Coverage__c</object>
        <queriedFields>Id</queriedFields>
        <queriedFields>Equipment__c</queriedFields>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordUpdates>
        <description>Saves Current Coverage Plan on all covered units in one update.</description>
        <name>Update_Units</name>
        <label>Update Units</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>END_ELEMENT_1</targetReference>
        </connector>
        <faultConnector>
            <targetReference>Show_Activation_Error</targetReference>
        </faultConnector>
        <inputReference>colUnits</inputReference>
    </recordUpdates>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Get_Links</targetReference>
        </connector>
        <doesRequireRecordChangedToMeetCriteria>true</doesRequireRecordChangedToMeetCriteria>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Status__c</field>
            <operator>EqualTo</operator>
            <value>
                <stringValue>Active</stringValue>
            </value>
        </filters>
        <object>Coverage_Plan__c</object>
        <recordTriggerType>CreateAndUpdate</recordTriggerType>
        <triggerType>RecordAfterSave</triggerType>
    </start>
    <status>Active</status>
    <variables>
        <description>All units to update in one go after the loop.</description>
        <name>colUnits</name>
        <dataType>SObject</dataType>
        <isCollection>true</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <objectType>Equipment__c</objectType>
    </variables>
    <variables>
        <description>One equipment unit to update.</description>
        <name>varUnit</name>
        <dataType>SObject</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <objectType>Equipment__c</objectType>
    </variables>
</Flow>
